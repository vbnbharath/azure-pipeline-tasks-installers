{
    "compileOnSave": true,
    "compilerOptions": {
        "module": "nodenext",
        "target": "esnext",
        "sourceMap": false,
        "strict": true,
        "strictNullChecks": false,
        "moduleResolution": "nodenext",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true
    },
    "include": [
        "./Common/*.ts",
        "./Common/resources.json",
    ],
    "exclude": [
        "node_modules",
        "*/node_modules",
        "*/**/*.js"
    ]
}
